{
  "name": "30-days-of-react-native",
  "version": "1.0.0",
  "description": "A complete, 30-day open-source curriculum to master modern React Native, Expo SDK 58, and TypeScript from beginner to production.",
  "main": "expo-router/entry",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "validate:curriculum": "node scripts/validate-curriculum.mjs",
    "validate:links": "node scripts/validate-links.mjs",
    "validate:all": "npm run validate:curriculum && npm run validate:links && npm run typecheck && npm run lint && npm test",
    "progress": "node scripts/check-progress.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.0.1",
    "@react-native-async-storage/async-storage": "^2.1.2",
    "@tanstack/react-query": "^5.90.0",
    "axios": "^1.8.4",
    "expo": "~58.0.0",
    "expo-camera": "~58.0.0",
    "expo-clipboard": "~58.0.0",
    "expo-constants": "~58.0.0",
    "expo-haptics": "~58.0.0",
    "expo-image": "~58.0.0",
    "expo-image-picker": "~58.0.0",
    "expo-linking": "~58.0.0",
    "expo-location": "~58.0.0",
    "expo-notifications": "~58.0.0",
    "expo-router": "~58.0.0",
    "expo-secure-store": "~58.0.0",
    "expo-sharing": "~58.0.0",
    "expo-sqlite": "~58.0.0",
    "expo-status-bar": "~58.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.55.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-reanimated": "~3.17.4",
    "react-native-safe-area-context": "^5.4.0",
    "react-native-screens": "~4.10.0",
    "zod": "^4.0.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.24.0",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.3.0",
    "eslint": "^9.24.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.0.0",
    "jest": "^29.7.0",
    "jest-expo": "~58.0.0",
    "prettier": "^3.5.3",
    "test-renderer": "^1.3.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1"
  },
  "keywords": [
    "react-native",
    "expo",
    "typescript",
    "mobile-development",
    "30-days-of-react-native",
    "tutorial",
    "learning",
    "open-source"
  ]
}
